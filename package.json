{
  "name": "gestion-documental-back",
  "version": "1.0.0",
  "description": "Backend API for Document Management System using DDD + Clean Architecture",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run tsc -b",
    "start": "bun run dist/index.js",
    "dev": "bun run --hot src/index.ts",
    "test": "bun test src",
    "test:watch": "bun test --watch src",
    "test:coverage": "bun test --coverage src",
    "lint": "bun run eslint src/**/*.ts",
    "lint:fix": "bun run eslint src/**/*.ts --fix",
    "lint:ts": "bun run tsc -b --noEmit",
    "migration:create": "typeorm migration:create",
    "migration:generate": "typeorm migration:generate -d migrate-data-source.js",
    "migration:run": "typeorm migration:run -d migrate-data-source.js",
    "migration:revert": "typeorm migration:revert -d migrate-data-source.js",
    "migration:show": "typeorm migration:show -d migrate-data-source.js",
    "migration:compare": "node dev/scripts/compare-migrations.js",
    "install:bun": "bun install",
    "clean": "rm -rf node_modules bun.lockb dist",
    "seeder": "bun run seeder.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript",
    "ddd",
    "clean-architecture",
    "sqlserver",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "3.939.0",
    "archiver": "5.3.2",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "4.4.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "nodemailer": "8.0.7",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.1.13",
    "twilio": "^6.0.2",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@stylistic/eslint-plugin": "5.5.0",
    "@types/archiver": "6.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "1.2.23",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "24.10.0",
    "@types/nodemailer": "8.0.0",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^2.0.16",
    "@types/uuid": "^9.0.7",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "17.4.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "sql.js": "1.13.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.38.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  },
  "trustedDependencies": [
    "@types/node",
    "typescript"
  ]
}
