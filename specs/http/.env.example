# Environment Variables for HTTP Tests
# Copy this file to .env and fill in the actual IDs from your database

#auth
AUTH_EMAIL=email@example.com
AUTH_PASSWORD=password

# Document Type (get from GET /api/documents/types)
DOCUMENT_TYPE_ID=your-document-type-id-here
DOCUMENT_TYPE_NAME=your-document-name-here

# Document Subtype ID (get from GET /api/documents/subtypes)
DOCUMENT_SUBTYPE_ID=your-document-subtype-id-here

# Contract ID (get from GET /api/contracts)
CONTRACT_ID=your-contract-id-here

# File ID (get from POST /api/files)
FILE_ID=your-file-id-here
