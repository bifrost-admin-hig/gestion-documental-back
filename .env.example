# Environment Configuration
NODE_ENV=development
PORT=3000
ENABLE_RBAC=true

# Database Configuration (MySQL Local)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=gestion_user
DB_PASSWORD=password
DB_DATABASE=gestion_documental
# root credentials for migrations and initial setup
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=password

# Test Database Configuration
# TEST_DB_TYPE=mysql
# TEST_DB_HOST=localhost
# TEST_DB_PORT=3306
# TEST_DB_USERNAME=gestion_user
# TEST_DB_PASSWORD=password
# TEST_DB_DATABASE=test_gestion_documental

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
SIGNATURE_SECRET=your-super-secret-signature-key-change-this-in-production

COOKIE_SECURE=false
COOKIE_SAMESITE=strict
COOKIE_MAX_AGE_MS=3600000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# URL pública del frontend. Se usa para CORS, emails de activación
# y la URL embebida en el QR de validación de firma electrónica.
FRONTEND_URL=http://localhost:3000

# External API Configuration
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_API_KEY=your-api-key-here

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,txt
FILE_STORAGE=local
FILE_STORAGE_LOCAL_PATH=./uploads

# AWS S3 Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_BUCKET_CONTAINER=highdare-document-manager
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@gestion-documental.com
FROM_NAME=nombre-de-la-app

# SMS Configuration (for notifications)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Signature Flow Configuration
# Cada cuánto (ms) el processor revisa flujos de firma vencidos para cerrarlos automáticamente.
SIGNATURE_FLOW_AUTO_CLOSE_INTERVAL_MS=900000

# First user credentials. When you're first time deploy
# you can use this credentials to login and setup the application.
# Left the email empty if you want to ignore the seeder.
SEEDER_ADMIN_EMAIL=
SEEDER_ADMIN_PASSWORD=
SEEDER_ADMIN_ROLE=Admin
